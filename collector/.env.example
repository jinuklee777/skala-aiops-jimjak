# collector/.env 로 복사해서 쓴다. .env는 커밋되지 않는다.

# data.go.kr 마이페이지의 일반 인증키. Encoding·Decoding 어느 쪽을 넣어도 된다.
DATA_GO_KR_SERVICE_KEY=

# 아래는 필요할 때만.
